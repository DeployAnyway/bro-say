{
  "name": "@deployanyway/bro-say",
  "version": "1.0.0",
  "description": "Build/test summaries, original terminal characters and Unicode speech bubbles. Emotional support for production, with receipts.",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./browser": {
      "types": "./index.d.ts",
      "default": "./dist/browser.js"
    }
  },
  "bin": {
    "bro-say": "./bin/cli.js",
    "bro-think": "./bin/think.js"
  },
  "files": [
    "dist",
    "src",
    "bin",
    "index.d.ts",
    "index.d.cts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "MIGRATION.md",
    "examples"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "node scripts/build.mjs",
    "pretest": "npm run build",
    "coverage": "c8 --all --include=src/**/*.js --exclude=src/characters/index.js --reporter=text --reporter=json-summary --reporter=lcov --check-coverage --lines=90 --statements=90 --functions=90 --branches=85 node --test test/*.test.js",
    "test:types": "tsc -p tsconfig.json",
    "verify:package": "node scripts/verify-package.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeployAnyway/bro-say.git"
  },
  "bugs": {
    "url": "https://github.com/DeployAnyway/bro-say/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "c8": "^12.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "cli",
    "developer-tools",
    "terminal",
    "message-formatter",
    "developer-humor",
    "console",
    "ascii-art",
    "unicode",
    "speech-bubble",
    "stdin",
    "humor",
    "deployanyway",
    "build-summary",
    "test-results"
  ],
  "dependencies": {
    "string-width": "^8.3.0",
    "wrap-ansi": "^10.0.2"
  },
  "homepage": "https://deployanyway.github.io/",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./index.d.ts"
}
